{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "newLine": "lf",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "removeComments": false,
    "pretty": true,
    "types": ["jquery"]
  },
  "include": ["assets/**/*.ts", "assets/**/*.d.ts"]
}
